# SearchField

```ts
export interface SearchField {

    /**
     * react-hook-form field name
     */
    name: string;

    /**
     * Field label
     */
    label: string;

    /**
     * Field component type
     */
    type: SearchFieldType;

    /**
     * 12-column grid width
     */
    colSpan?: number;

    /**
     * Placeholder
     */
    placeholder?: string;

    /**
     * Select options
     */
    options?: SelectOption[];

    /**
     * Disabled state
     */
    disabled?: boolean;

    /**
     * Visibility
     */
    visible?: boolean;

}
```

